<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NeuralSharp.Classification.Cli</RootNamespace>
    <AssemblyName>nsclassify</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nsclassify</ToolCommandName>
    <PackageId>NeuralSharp.Classification.Cli</PackageId>
    <Version>0.1.0</Version>
    <!-- A new package version on every pack (0.1.yyMMdd.HHmm, UTC), so "dotnet tool update" always installs the latest. -->
    <PackageVersion>0.1.$([System.DateTime]::UtcNow.ToString("yyMMdd")).$([System.DateTime]::UtcNow.ToString("HHmm").TrimStart("0"))</PackageVersion>
    <Description>nsclassify: train, evaluate and run text classifiers (intents, topics, routing; any language) on a GPU or CPU from labeled texts in CSV, JSON Lines, Parquet or Hugging Face datasets.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuralSharp.Classification\NeuralSharp.Classification.csproj" />
  </ItemGroup>

</Project>
