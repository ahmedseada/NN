<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NeuralSharp.FineTuning.Cli</RootNamespace>
    <AssemblyName>nstune</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nstune</ToolCommandName>
    <PackageId>NeuralSharp.FineTuning.Cli</PackageId>
    <Version>0.1.0</Version>
    <!-- A new package version on every pack (0.1.yyMMdd.HHmm, UTC), so "dotnet tool update" always installs the latest. -->
    <PackageVersion>0.1.$([System.DateTime]::UtcNow.ToString("yyMMdd")).$([System.DateTime]::UtcNow.ToString("HHmm").TrimStart("0"))</PackageVersion>
    <Description>nstune: fine-tune pretrained language models (LoRA / QLoRA) on any dataset nsdata reads, evaluate them, chat with them and export them; one tool for every fine-tuning job.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuralSharp\NeuralSharp.csproj" />
    <ProjectReference Include="..\NeuralSharp.Datasets\NeuralSharp.Datasets.csproj" />
    <ProjectReference Include="..\NeuralSharp.Pretrained\NeuralSharp.Pretrained.csproj" />
  </ItemGroup>

</Project>
