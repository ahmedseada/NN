<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NeuralSharp.Onnx</RootNamespace>
    <AssemblyName>NeuralSharp.Onnx</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>NeuralSharp.Onnx</PackageId>
    <Description>ONNX export for NeuralSharp models (no dependencies): networks become .onnx files that ONNX Runtime, TensorRT, OpenVINO, DirectML and other runtimes can run.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuralSharp\NeuralSharp.csproj" />
  </ItemGroup>

</Project>
