<Project Sdk="Microsoft.NET.Sdk">

  <!-- The command line: train, evaluate and try intent models. An application built on NeuralSharp (not part of the
       library): it references the library projects the way any consumer would; once NeuralSharp is published as
       packages, swap them for PackageReferences. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Qasd</RootNamespace>
    <AssemblyName>qasd</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qasd.Core\Qasd.Core.csproj" />
  </ItemGroup>

</Project>
