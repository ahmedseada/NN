              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Healthy\", () => { pm.response.to.have.status(200); pm.expect(pm.response.text()).to.eql(\"Healthy\"); });"
                ]
              }
