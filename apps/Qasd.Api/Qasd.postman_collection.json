              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "description": "A short reply whose intent depends on the conversation: expect a low confidence and accepted = false, meaning: send it to the fallback.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"ok\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
