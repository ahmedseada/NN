        {
          "name": "Low confidence → fallback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "description": "A short reply whose intent depends on the conversation: expect a low confidence and accepted = false, meaning: send it to the fallback.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"ok\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"has a label and confidence\", () => { pm.expect(r.label).to.be.a(\"string\"); pm.expect(r.confidence).to.be.within(0, 1); });",
                  "pm.test(\"probabilities add up to 1\", () => pm.expect(r.probabilities.reduce((s, p) => s + p.probability, 0)).to.be.closeTo(1, 0.001));",
                  "pm.test(\"accepted matches MinConfidence\", () => pm.expect(r.accepted).to.eql(r.confidence >= Number(pm.collectionVariables.get(\"minConfidence\") || 0.6)));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Classify batch",
      "item": [
        {
          "name": "Several messages",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify",
                "batch"
              ]
            },
            "description": "Up to MaxBatch (256) messages in one pass through the model; results in the order of the request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texts\": [\n    \"Book me with Dr. Heba Mansour in neurology on Tuesday at 12:30\",\n    \"what are the available days?\",\n    \"هلا\",\n    \"ايه هي خدماتكم\",\n    \"عايز احجز مع د. هبة يوم الخميس\",\n    \"where are you located?\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw).texts;",
                  "pm.test(\"one result per message, in order\", () => { pm.expect(r.results.length).to.eql(sent.length); r.results.forEach((x, i) => pm.expect(x.text).to.eql(sent[i])); });",
                  "pm.test(\"reports the model time\", () => pm.expect(r.elapsedMilliseconds).to.be.at.least(0));",
                  "console.log(r.results.map(x => `${x.label} ${(x.confidence * 100).toFixed(1)}% ${x.accepted ? \"\" : \"(fallback)\"} ${x.text}`).join(\"\\n\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation errors",
      "item": [
        {
          "name": "Empty message → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 with a validation problem\", () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.be.an(\"object\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Empty batch → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify",
                "batch"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texts\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 with a validation problem\", () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.have.property(\"texts\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Model and service",
      "item": [
        {
          "name": "Model info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/model",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "model"
              ]
            },
            "description": "The model file, its intents, the device, when it was loaded and MinConfidence (saved to the minConfidence variable)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const m = pm.response.json();",
                  "pm.test(\"lists the intents\", () => pm.expect(m.labels.length).to.be.above(1));",
                  "pm.collectionVariables.set(\"minConfidence\", m.minConfidence);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reload the model (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/model/reload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "model",
                "reload"
              ]
            },
            "description": "After retraining: loads IntentModel:Path again without dropping requests in flight. Set adminKey to the service's IntentModel:AdminKey."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with the key the service was started with, 401 otherwise\", () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reload without the key → 401",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/model/reload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "model",
                "reload"
              ]
            },
            "description": ""
