              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"has a label and confidence\", () => { pm.expect(r.label).to.be.a(\"string\"); pm.expect(r.confidence).to.be.within(0, 1); });",
                  "pm.test(\"probabilities add up to 1\", () => pm.expect(r.probabilities.reduce((s, p) => s + p.probability, 0)).to.be.closeTo(1, 0.001));",
