    {
      "name": "Classify batch",
      "item": [
        {
          "name": "Several messages",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify",
                "batch"
              ]
            },
            "description": "Up to MaxBatch (256) messages in one pass through the model; results in the order of the request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texts\": [\n    \"Book me with Dr. Heba Mansour in neurology on Tuesday at 12:30\",\n    \"what are the available days?\",\n    \"هلا\",\n    \"ايه هي خدماتكم\",\n    \"عايز احجز مع د. هبة يوم الخميس\",\n    \"where are you located?\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw).texts;",
                  "pm.test(\"one result per message, in order\", () => { pm.expect(r.results.length).to.eql(sent.length); r.results.forEach((x, i) => pm.expect(x.text).to.eql(sent[i])); });",
                  "pm.test(\"reports the model time\", () => pm.expect(r.elapsedMilliseconds).to.be.at.least(0));",
                  "console.log(r.results.map(x => `${x.label} ${(x.confidence * 100).toFixed(1)}% ${x.accepted ? \"\" : \"(fallback)\"} ${x.text}`).join(\"\\n\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tuned model and streaming",
      "item": [
        {
          "name": "Tuned model: one message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Book me with Dr. Heba Mansour in neurology on Tuesday at 12:30\",\n  \"model\": \"tuned\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The tuned language model (IntentModel:TunedPath). Returns 400 when the service has no tuned model."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 400) { pm.test(\"tuned model not configured (400)\", () => pm.expect(pm.response.json().errors).to.have.property(\"model\")); return; }",
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"classified by the tuned model\", () => { pm.expect(r.model).to.eql(\"tuned\"); pm.expect(r.probabilities.length).to.be.above(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Tuned model: streamed (SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"what are the available days?\",\n  \"model\": \"tuned\",\n  \"stream\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Server-Sent Events: token (the model's answer as it is generated), result, done."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 400) { pm.test(\"tuned model not configured (400)\", () => pm.expect(pm.response.json().errors).to.have.property(\"model\")); return; }",
                  "pm.test(\"200 text/event-stream\", () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\"); });",
                  "const body = pm.response.text();",
                  "pm.test(\"token, result and done events\", () => { pm.expect(body).to.include(\"event: token\"); pm.expect(body).to.include(\"event: result\"); pm.expect(body).to.include(\"event: done\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Classifier batch: streamed (SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
