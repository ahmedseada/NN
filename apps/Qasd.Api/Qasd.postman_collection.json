{
  "info": {
    "name": "Qasd: intent classifier",
    "description": "Requests for Qasd.Api (apps/Qasd.Api). Start the service with\n\n    dotnet run -c Release --project apps/Qasd.Api\n\nthen run the collection (baseUrl defaults to http://localhost:5080). The reload request needs the service's IntentModel:AdminKey in the adminKey variable (set IntentModel__AdminKey when starting it).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "adminKey",
      "value": "change-me"
    },
    {
      "key": "minConfidence",
      "value": "0.6"
    }
  ],
  "item": [
    {
      "name": "Classify",
      "item": [
        {
          "name": "Book an appointment (English)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "description": "One message → the most likely intent, its confidence, accepted (confidence ≥ MinConfidence) and every intent's probability.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Book me with Dr. Heba Mansour in neurology on Tuesday at 12:30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"has a label and confidence\", () => { pm.expect(r.label).to.be.a(\"string\"); pm.expect(r.confidence).to.be.within(0, 1); });",
                  "pm.test(\"probabilities add up to 1\", () => pm.expect(r.probabilities.reduce((s, p) => s + p.probability, 0)).to.be.closeTo(1, 0.001));",
                  "pm.test(\"accepted matches MinConfidence\", () => pm.expect(r.accepted).to.eql(r.confidence >= Number(pm.collectionVariables.get(\"minConfidence\") || 0.6)));",
                  "pm.test(\"classified as function_call\", () => pm.expect(r.label).to.eql(\"function_call\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Available days (English)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "classify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"what are the available days?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"has a label and confidence\", () => { pm.expect(r.label).to.be.a(\"string\"); pm.expect(r.confidence).to.be.within(0, 1); });",
                  "pm.test(\"probabilities add up to 1\", () => pm.expect(r.probabilities.reduce((s, p) => s + p.probability, 0)).to.be.closeTo(1, 0.001));",
                  "pm.test(\"accepted matches MinConfidence\", () => pm.expect(r.accepted).to.eql(r.confidence >= Number(pm.collectionVariables.get(\"minConfidence\") || 0.6)));",
                  "pm.test(\"classified as retrieve\", () => pm.expect(r.label).to.eql(\"retrieve\"));"
                ]
              }
            }
          ]
        },
