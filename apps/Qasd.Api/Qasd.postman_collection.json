            "body": {
              "mode": "raw",
              "raw": "{\n  \"texts\": [\n    \"hello\",\n    \"what are the available days?\",\n    \"ايه هي خدماتكم\"\n  ],\n  \"model\": \"classifier\",\n  \"stream\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A result event per message as it is ready, then done."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 text/event-stream\", () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\"); });",
                  "const body = pm.response.text();",
                  "pm.test(\"a result event per message, then done\", () => { pm.expect((body.match(/event: result/g) || []).length).to.eql(3); pm.expect(body).to.include(\"event: done\"); });"
                ]
              }
            }
          ]
        },
